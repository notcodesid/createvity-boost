{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@createvity/shared": ["../../packages/shared/src/index.ts"],
      "@createvity/chain": ["../../packages/chain/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
